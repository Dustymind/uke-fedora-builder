#!/usr/bin/python3
"""Reset the WN8030 MiAuth window.

The MCU asks for an MiAuth token (0x24, p[6]=0x64 "repeat request auth") on a
period of its own and stops reporting keys when the window closes.  The token
lives in the Android devauth TA backed by RPMB; Linux has no way to produce one,
so answering is not an option and neither is silence - the window still closes.

Two ways to reset it:

  soft reset   write 1 to the driver's soft_reset attribute.  The driver pulses
               the MCU reset line and waits for the bootrom: about 70 ms, with
               the supplies untouched and the HID devices left registered.
  rebind       unbind and bind the I2C driver.  Correct but expensive: the
               unbind path disables both regulators and the bind path charges
               them again, so the keyboard is deaf for roughly a second.

A rebind is expensive, so the pulse is tried first and the rebind is the
fallback.  Both leave the MCU running fresh firmware: the driver downloads
nanosic/MCU_Upgrade.bin after the pulse exactly as it does at probe, and fails
the write when that download fails, so `auto` falls back instead of leaving the
chip in its bootrom.  An earlier revision pulsed reset and stopped there - the
write returned success, the chip stayed in the bootrom, and the keyboard was
deaf from the first reset on while this log kept printing `soft: reset`.

`auto` also escalates.  A pulse that the driver reports as successful can still
leave a deaf keyboard, and the only symptom is that no key ever arrives; two
pulses in a row with no key event therefore switch the next reset to a rebind,
which always runs the full probe.  The switch back is the arrival of a key, so an
idle tablet pays for a rebind per period and an actively used one keeps the
pulse.  `soft` is left alone: it is the mode that says "never rebind".

Two things this does better than a plain timer:

  * It waits for an idle gap.  Rebinding between keystrokes is invisible;
    rebinding mid-word drops them.
  * It records what it did, with timestamps, so the real window length can be
    measured instead of guessed.  A period shorter than the window costs
    keystrokes for nothing; longer means the keyboard dies before the reset.

Environment (set by nanosic-rebind.service, overridable with `systemctl edit`,
which only takes effect after `systemctl restart nanosic-rebind.service`):
  NANOSIC_REBIND_PERIOD   seconds between resets (default 50)
  NANOSIC_REBIND_IDLE     required idle gap in seconds (default 1.5)
  NANOSIC_REBIND_RESET    auto (default), rebind, or soft
                          auto uses the pulse and falls back to a rebind when
                          the write fails, which is what a driver without the
                          attribute, a suspended chip or a firmware reload that
                          did not take looks like

`idle` in a log line is the time since the last key, not the configured gap.  It
grows while nobody types, and it grows without bound when the keyboard is
already deaf; the two used to look the same, so a keyboard that never came back
after a reset only showed up as a number going up.  A run with no key events at
all now says `no key since start`, and a run that gives up on the pulse says so.
"""

import glob
import os
import select
import struct
import sys
import time

DRIVER = "/sys/bus/i2c/drivers/nanosic_wn8030"
DEVICE = "5-004c"
SOFT_RESET = "/sys/bus/i2c/devices/" + DEVICE + "/soft_reset"
PERIOD = float(os.environ.get("NANOSIC_REBIND_PERIOD", "50"))
IDLE = float(os.environ.get("NANOSIC_REBIND_IDLE", "1.5"))
# A failed attempt used to be retried on the next pass of the select loop, which
# is every half second: at 2 Hz a broken sysfs path fills the journal and hammers
# the I2C bus for nothing.
RETRY = 5.0
MODE = os.environ.get("NANOSIC_REBIND_RESET", "auto").strip().lower()


def log(message):
    print(message, flush=True)


def find_keyboard_event():
    """The event node of the internal keyboard, not the touchpad or the lid."""
    for name in sorted(glob.glob("/sys/class/input/event*/device/name")):
        try:
            with open(name) as handle:
                if handle.read().strip() == "Xiaomi Keyboard":
                    return "/dev/input/" + name.split("/")[-3]
        except OSError:
            continue
    return None


def soft_reset():
    try:
        with open(SOFT_RESET, "w") as handle:
            handle.write("1")
        return True
    except OSError as exc:
        # A kernel without the attribute and an SELinux denial used to look
        # exactly like a successful pulse: this is the only place that says
        # which one it was.
        log(f"soft: cannot write {SOFT_RESET}: {exc}")
        return False


def rebind():
    for step in ("unbind", "bind"):
        try:
            with open(f"{DRIVER}/{step}", "w") as handle:
                handle.write(DEVICE)
        except OSError as exc:
            log(f"rebind: cannot write {step}: {exc}")
            return False
        if step == "unbind":
            # Let the remove path finish before the bind path starts walking
            # the same device back up.
            time.sleep(0.02)
    return True


def reset(force_rebind=False):
    """Reset the window; returns how, or None when nothing could be done."""
    if not force_rebind:
        if MODE == "soft":
            return "soft" if soft_reset() else None
        if MODE == "auto" and soft_reset():
            return "soft"
    return "rebind" if rebind() else None


def main():
    if MODE not in ("rebind", "soft", "auto"):
        log(f"rebind: NANOSIC_REBIND_RESET={MODE!r} is not "
            f"rebind, soft or auto")
        return 2
    if not os.path.exists(f"{DRIVER}/{DEVICE}"):
        log(f"rebind: {DRIVER}/{DEVICE} is absent; nothing to do")
        return 1

    log(f"rebind: period {PERIOD:.0f}s, idle {IDLE:.1f}s, reset {MODE}")
    last_reset = time.monotonic()
    last_key = None
    last_attempt = 0.0
    typed = False
    keyless = 0
    warned = False

    while True:
        event = find_keyboard_event()
        if event is None:
            time.sleep(1)
            continue

        try:
            handle = os.open(event, os.O_RDONLY | os.O_NONBLOCK)
        except OSError:
            time.sleep(1)
            continue

        try:
            while True:
                now = time.monotonic()
                ready, _, _ = select.select([handle], [], [], 0.5)
                if ready:
                    data = os.read(handle, 24 * 64)
                    for offset in range(0, len(data) - 23, 24):
                        _, _, kind, _, _ = struct.unpack_from("qqHHI", data, offset)
                        if kind == 1:  # EV_KEY
                            last_key = now
                            typed = True

                if now - last_reset < PERIOD:
                    continue
                # Past the period: reset as soon as the user pauses, but never
                # wait longer than a second window or the MCU may already have
                # stopped.
                if (last_key is not None and now - last_key < IDLE
                        and now - last_reset < PERIOD + 1.0):
                    continue
                if now - last_attempt < RETRY:
                    continue

                # Two soft resets in a row that produced no key at all: the
                # MCU is probably not running its firmware, and a rebind is the
                # only thing that re-runs probe and downloads it again.
                escalate = MODE == "auto" and keyless >= 2
                how = reset(force_rebind=escalate)
                last_attempt = time.monotonic()
                if how is None:
                    continue
                gap = ("no key since start" if last_key is None
                       else f"idle {now - last_key:.1f}s")
                log(f"{how}: reset at {time.monotonic() - last_reset:.1f}s "
                    f"({gap})")
                last_reset = time.monotonic()

                keyless = 0 if typed else keyless + 1
                typed = False
                if MODE == "auto" and keyless == 3 and not warned:
                    warned = True
                    log("rebind: three resets without a key; using a full "
                        "rebind until one arrives")
                break
        except OSError:
            pass
        finally:
            os.close(handle)

        time.sleep(0.5)


if __name__ == "__main__":
    sys.exit(main())
